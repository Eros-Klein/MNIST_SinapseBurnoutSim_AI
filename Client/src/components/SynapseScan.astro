---
import background from "../assets/background.svg";
---

<div id="container">
  <img id="background" src={background.src} alt="" fetchpriority="high" />
  <main>
    <!-- Hero -->
    <section id="hero">
      <a href="/" id="logo">
        <svg width="64" height="64" viewBox="0 0 500 200" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="textGradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#00f5ff"/>
              <stop offset="50%" stop-color="#7a5cff"/>
              <stop offset="100%" stop-color="#ff4d9d"/>
            </linearGradient>
            <filter id="neonGlow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="6" result="blur1"/>
              <feGaussianBlur in="SourceGraphic" stdDeviation="2" result="blur2"/>
              <feMerge>
                <feMergeNode in="blur1"/>
                <feMergeNode in="blur2"/>
                <feMergeNode in="SourceGraphic"/>
              </feMerge>
            </filter>
          </defs>
          <text
            x="50%" y="60%"
            text-anchor="middle"
            dominant-baseline="middle"
            font-family="Brush Script MT, Pacifico, cursive"
            font-size="220"
            font-weight="600"
            fill="url(#textGradient)"
            filter="url(#neonGlow)"
          >SB</text>
        </svg>
        SynapseBurner
      </a>

      <div id="headline">
        <h1>Upload Here!</h1>
        <p class="subtitle">
          Upload a 28×28×28 NumPy volume (<code>.npy</code>) for inference. The API evaluates it and returns a label, confidence, and a preview slice.
        </p>

        <div id="upload-area">
          <label id="drop-zone" for="file-input">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            <span id="drop-label">Drag & drop or <strong>browse</strong></span>
            <span id="drop-hint">Single <code>.npy</code> file — shape must be 28×28×28</span>
            <input id="file-input" type="file" accept=".npy,application/octet-stream" />
          </label>
          <div hidden id="preview-wrap">
            <div id="preview-thumb" aria-hidden="true">NPY</div>
            <span id="preview-name"></span>
          </div>
        </div>

        <section id="volume-panel" class="volume-panel" hidden>
          <h2 class="volume-heading">3D volume</h2>
          <p class="volume-hint">
            Drag to rotate, scroll to zoom. Use the sliders for orthogonal slices. Lower the threshold to show more low-intensity voxels.
          </p>
          <div class="volume-layout">
            <div id="volume-webgl-host" class="volume-webgl-host"></div>
            <div class="volume-slices">
              <div class="slice-block">
                <label class="slice-label">XY slice (Z) <span id="slice-z-val" class="slice-val"></span><input type="range" id="slice-z" min="0" max="27" value="14" /></label>
                <canvas id="slice-canvas-xy" class="slice-canvas"></canvas>
              </div>
              <div class="slice-block">
                <label class="slice-label">XZ slice (Y) <span id="slice-y-val" class="slice-val"></span><input type="range" id="slice-y" min="0" max="27" value="14" /></label>
                <canvas id="slice-canvas-xz" class="slice-canvas"></canvas>
              </div>
              <div class="slice-block">
                <label class="slice-label">YZ slice (X) <span id="slice-x-val" class="slice-val"></span><input type="range" id="slice-x" min="0" max="27" value="14" /></label>
                <canvas id="slice-canvas-yz" class="slice-canvas"></canvas>
              </div>
            </div>
          </div>
          <label class="thresh-label">Intensity cutoff <input type="range" id="volume-threshold" min="0" max="100" value="10" /><span id="threshold-val" class="slice-val"></span></label>
        </section>

        <div id="cta">
          <button type="button" id="scan-btn" class="btn btn-primary" disabled>
            <span id="scan-btn-label">Scan Synapse</span>
            <svg id="scan-btn-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </button>
          <a class="btn btn-ghost" href="/results">Past results</a>
          <a class="btn btn-ghost" href="/">Back Home</a>
        </div>

        <div id="error-panel" role="alert" hidden></div>

        <div id="result-panel" hidden>
          <h2 class="result-heading">Result</h2>
          <div class="result-summary">
            <p class="result-label" id="result-label"></p>
            <p class="result-score">Confidence: <strong id="result-score"></strong></p>
            <p class="result-meta" id="result-meta"></p>
          </div>
          <section class="volume-panel">
            <h3 class="volume-heading">3D result volume</h3>
            <p class="volume-hint">Drag to rotate, scroll to zoom. Use the sliders for orthogonal slices.</p>
            <div class="volume-layout">
              <div id="result-webgl-host" class="volume-webgl-host"></div>
              <div class="volume-slices">
                <div class="slice-block">
                  <label class="slice-label">XY slice (Z) <span id="result-slice-z-val" class="slice-val"></span><input type="range" id="result-slice-z" min="0" max="27" value="14" /></label>
                  <canvas id="result-slice-xy" class="slice-canvas"></canvas>
                </div>
                <div class="slice-block">
                  <label class="slice-label">XZ slice (Y) <span id="result-slice-y-val" class="slice-val"></span><input type="range" id="result-slice-y" min="0" max="27" value="14" /></label>
                  <canvas id="result-slice-xz" class="slice-canvas"></canvas>
                </div>
                <div class="slice-block">
                  <label class="slice-label">YZ slice (X) <span id="result-slice-x-val" class="slice-val"></span><input type="range" id="result-slice-x" min="0" max="27" value="14" /></label>
                  <canvas id="result-slice-yz" class="slice-canvas"></canvas>
                </div>
              </div>
            </div>
            <label class="thresh-label">Intensity cutoff <input type="range" id="result-threshold" min="0" max="100" value="10" /><span id="result-threshold-val" class="slice-val"></span></label>
          </section>
        </div>
      </div>
    </section>
  </main>
</div>

<script>
  import { uploadVolume, type ImageEntry } from "../lib/api";
  import { parseNpyBuffer, type ParsedVolume } from "../lib/npyParse";
  import { createVolumeView, type VolumeViewHandle } from "../lib/volumeViewer";

  const fileInput = document.getElementById("file-input") as HTMLInputElement;
  const scanBtn = document.getElementById("scan-btn") as HTMLButtonElement;
  const scanBtnLabel = document.getElementById("scan-btn-label") as HTMLSpanElement;
  const scanBtnIcon = document.getElementById("scan-btn-icon") as SVGElement;
  const dropZone = document.getElementById("drop-zone") as HTMLLabelElement;
  const previewWrap = document.getElementById("preview-wrap") as HTMLDivElement;
  const previewName = document.getElementById("preview-name") as HTMLSpanElement;
  const volumePanel = document.getElementById("volume-panel") as HTMLElement;
  const volumeWebglHost = document.getElementById("volume-webgl-host") as HTMLElement;
  const sliceZ = document.getElementById("slice-z") as HTMLInputElement;
  const sliceY = document.getElementById("slice-y") as HTMLInputElement;
  const sliceX = document.getElementById("slice-x") as HTMLInputElement;
  const sliceZVal = document.getElementById("slice-z-val") as HTMLSpanElement;
  const sliceYVal = document.getElementById("slice-y-val") as HTMLSpanElement;
  const sliceXVal = document.getElementById("slice-x-val") as HTMLSpanElement;
  const canvasXy = document.getElementById("slice-canvas-xy") as HTMLCanvasElement;
  const canvasXz = document.getElementById("slice-canvas-xz") as HTMLCanvasElement;
  const canvasYz = document.getElementById("slice-canvas-yz") as HTMLCanvasElement;
  const thresholdInput = document.getElementById("volume-threshold") as HTMLInputElement;
  const thresholdVal = document.getElementById("threshold-val") as HTMLSpanElement;
  const errorPanel = document.getElementById("error-panel") as HTMLDivElement;
  const resultPanel = document.getElementById("result-panel") as HTMLDivElement;
  const resultLabel = document.getElementById("result-label") as HTMLParagraphElement;
  const resultScore = document.getElementById("result-score") as HTMLStrongElement;
  const resultMeta = document.getElementById("result-meta") as HTMLParagraphElement;
  const resultWebglHost = document.getElementById("result-webgl-host") as HTMLElement;
  const resultSliceZ = document.getElementById("result-slice-z") as HTMLInputElement;
  const resultSliceY = document.getElementById("result-slice-y") as HTMLInputElement;
  const resultSliceX = document.getElementById("result-slice-x") as HTMLInputElement;
  const resultSliceZVal = document.getElementById("result-slice-z-val") as HTMLSpanElement;
  const resultSliceYVal = document.getElementById("result-slice-y-val") as HTMLSpanElement;
  const resultSliceXVal = document.getElementById("result-slice-x-val") as HTMLSpanElement;
  const resultCanvasXy = document.getElementById("result-slice-xy") as HTMLCanvasElement;
  const resultCanvasXz = document.getElementById("result-slice-xz") as HTMLCanvasElement;
  const resultCanvasYz = document.getElementById("result-slice-yz") as HTMLCanvasElement;
  const resultThreshold = document.getElementById("result-threshold") as HTMLInputElement;
  const resultThresholdVal = document.getElementById("result-threshold-val") as HTMLSpanElement;

  let volumeView: VolumeViewHandle | null = null;
  let resultVolumeView: VolumeViewHandle | null = null;
  let lastParsedVolume: ParsedVolume | null = null;

  function disposeVolumeView() {
    volumeView?.dispose();
    volumeView = null;
  }

  function updateThresholdLabel() {
    thresholdVal.textContent = `${thresholdInput.value}%`;
  }

  function isNpyFile(file: File): boolean {
    const name = file.name.toLowerCase();
    return name.endsWith(".npy");
  }

  function showError(message: string) {
    errorPanel.hidden = false;
    errorPanel.textContent = message;
    resultPanel.hidden = true;
  }

  function clearError() {
    errorPanel.hidden = true;
    errorPanel.textContent = "";
  }

  function disposeResultVolumeView() {
    resultVolumeView?.dispose();
    resultVolumeView = null;
  }

  function updateResultThresholdLabel() {
    resultThresholdVal.textContent = `${resultThreshold.value}%`;
  }

  function renderResult(entry: ImageEntry) {
    resultLabel.textContent = entry.evaluation.label;
    const pct = Math.round(entry.evaluation.score * 1000) / 10;
    resultScore.textContent = `${pct}%`;
    const when = new Date(entry.created_at).toLocaleString();
    const shape = `${entry.shape[0]}×${entry.shape[1]}×${entry.shape[2]}`;
    resultMeta.textContent = `${shape} · ${when}`;
    resultPanel.hidden = false;

    disposeResultVolumeView();
    if (!lastParsedVolume) return;

    resultWebglHost.innerHTML = "";
    resultVolumeView = createVolumeView(resultWebglHost, lastParsedVolume, {
      xy: resultCanvasXy,
      xz: resultCanvasXz,
      yz: resultCanvasYz,
      rangeZ: resultSliceZ,
      rangeY: resultSliceY,
      rangeX: resultSliceX,
      valZ: resultSliceZVal,
      valY: resultSliceYVal,
      valX: resultSliceXVal,
    });
    updateResultThresholdLabel();
    resultVolumeView.setThreshold(Number(resultThreshold.value) / 100);
    requestAnimationFrame(() => resultVolumeView?.relayout());
  }

  async function scanSynapse(file: File): Promise<void> {
    clearError();
    scanBtn.disabled = true;
    scanBtnLabel.textContent = "Scanning…";
    scanBtnIcon.style.display = "none";

    try {
      const entry = await uploadVolume(file);
      renderResult(entry);
    } catch (e) {
      showError(e instanceof Error ? e.message : "Something went wrong.");
    } finally {
      scanBtn.disabled = false;
      scanBtnLabel.textContent = "Scan Synapse";
      scanBtnIcon.style.display = "";
    }
  }

  async function loadFile(file: File) {
    if (!isNpyFile(file)) {
      showError("Please choose a .npy file (28×28×28 volume).");
      fileInput.value = "";
      scanBtn.disabled = true;
      previewWrap.hidden = true;
      volumePanel.hidden = true;
      disposeVolumeView();
      return;
    }
    clearError();
    previewName.textContent = file.name;
    previewWrap.hidden = false;
    previewWrap.style.display = "flex";
    scanBtn.disabled = false;

    disposeVolumeView();
    disposeResultVolumeView();
    lastParsedVolume = null;
    try {
      const buf = await file.arrayBuffer();
      const parsed = parseNpyBuffer(buf);
      lastParsedVolume = parsed;
      volumeWebglHost.innerHTML = "";
      volumeView = createVolumeView(volumeWebglHost, parsed, {
        xy: canvasXy,
        xz: canvasXz,
        yz: canvasYz,
        rangeZ: sliceZ,
        rangeY: sliceY,
        rangeX: sliceX,
        valZ: sliceZVal,
        valY: sliceYVal,
        valX: sliceXVal,
      });
      updateThresholdLabel();
      volumeView.setThreshold(Number(thresholdInput.value) / 100);
      volumePanel.hidden = false;
    } catch (e) {
      volumePanel.hidden = true;
      showError(e instanceof Error ? e.message : "Could not read this .npy file.");
    }
  }

  thresholdInput.addEventListener("input", () => {
    updateThresholdLabel();
    volumeView?.setThreshold(Number(thresholdInput.value) / 100);
  });

  resultThreshold.addEventListener("input", () => {
    updateResultThresholdLabel();
    resultVolumeView?.setThreshold(Number(resultThreshold.value) / 100);
  });

  fileInput.addEventListener("change", () => {
    const file = fileInput.files?.[0];
    if (file) void loadFile(file);
  });

  dropZone.addEventListener("dragover", (e) => {
    e.preventDefault();
    dropZone.classList.add("drag-over");
  });

  dropZone.addEventListener("dragleave", () => {
    dropZone.classList.remove("drag-over");
  });

  dropZone.addEventListener("drop", (e) => {
    e.preventDefault();
    dropZone.classList.remove("drag-over");
    const file = e.dataTransfer?.files[0];
    if (file) {
      void loadFile(file);
      try {
        const dt = new DataTransfer();
        dt.items.add(file);
        fileInput.files = dt.files;
      } catch {
        /* sync not supported — user can still click Scan if they re-pick */
      }
    }
  });

  scanBtn.addEventListener("click", () => {
    const file = fileInput.files?.[0];
    if (file) void scanSynapse(file);
  });
</script>

<style>
  /* ── Reset & base ─────────────────────────────── */
  #background {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    filter: blur(80px);
    opacity: 0.85;
  }

  #container {
    font-family: Inter, Roboto, "Helvetica Neue", Arial, sans-serif;
    min-height: 100%;
    color: #111827;
  }

  main {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 24px 64px;
  }

  /* ── Logo ─────────────────────────────────────── */
  #logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 40px;
    font-size: 22px;
    font-style: italic;
    font-weight: 800;
    color: #7a5cff;
    text-decoration: none;
    letter-spacing: -0.3px;
  }

  /* ── Hero ─────────────────────────────────────── */
  #hero {
    display: flex;
    flex-direction: column;
    padding-top: 16px;
  }

  #headline {
    margin-top: 40px;
  }

  #headline h1 {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 0 0 20px;
    color: #0f172a;
  }

  .gradient-text {
    background: linear-gradient(100deg, #00f5ff 0%, #7a5cff 50%, #ff4d9d 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    font-size: 18px;
    line-height: 1.7;
    color: #374151;
    max-width: 620px;
    margin: 0 0 36px;
  }

  .subtitle code {
    font-size: 0.9em;
    padding: 0.1em 0.35em;
    border-radius: 6px;
    background: rgba(122, 92, 255, 0.12);
    color: #5b21b6;
  }

  /* ── Upload area ──────────────────────────────── */
  #upload-area {
    margin-bottom: 28px;
  }

  #drop-zone {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 40px 32px;
    border-radius: 16px;
    border: 2px dashed rgba(122, 92, 255, 0.45);
    background: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(10px);
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
    color: #374151;
  }

  #drop-zone:hover,
  #drop-zone.drag-over {
    border-color: #7a5cff;
    background: rgba(122, 92, 255, 0.08);
  }

  #drop-label {
    font-size: 15px;
    font-weight: 500;
  }

  #drop-hint {
    font-size: 12px;
    color: #9ca3af;
  }

  #drop-hint code {
    font-size: 1em;
    padding: 0.05em 0.3em;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.06);
  }

  #file-input {
    display: none;
  }

  #preview-wrap {
    display: none;
    align-items: center;
    gap: 14px;
    margin-top: 16px;
    padding: 12px 16px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  #preview-thumb {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 8px;
    border: 1px solid rgba(122, 92, 255, 0.35);
    background: linear-gradient(135deg, rgba(0, 245, 255, 0.15), rgba(122, 92, 255, 0.2));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #5b21b6;
  }

  #preview-name {
    font-size: 14px;
    font-weight: 500;
    color: #374151;
    word-break: break-all;
  }

  /* ── 3D volume viewer ──────────────────────────── */
  .volume-panel {
    margin-bottom: 28px;
    padding: 22px 22px 24px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.62);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.85);
    box-shadow: 0 4px 28px rgba(0, 0, 0, 0.06);
  }

  .volume-heading {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 8px;
    letter-spacing: -0.02em;
  }

  .volume-hint {
    font-size: 14px;
    line-height: 1.6;
    color: #4b5563;
    margin: 0 0 18px;
    max-width: 720px;
  }

  .volume-layout {
    display: grid;
    grid-template-columns: minmax(260px, 1fr) minmax(200px, 1fr);
    gap: 20px;
    align-items: start;
  }

  @media screen and (max-width: 820px) {
    .volume-layout {
      grid-template-columns: 1fr;
    }
  }

  .volume-webgl-host {
    width: 100%;
    min-height: 300px;
    height: min(42vw, 380px);
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: #0c0c10;
  }

  .volume-slices {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .slice-block {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .slice-label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    color: #374151;
  }

  .slice-label input[type="range"] {
    flex: 1;
    min-width: 120px;
    accent-color: #7a5cff;
  }

  .slice-val {
    font-variant-numeric: tabular-nums;
    color: #7a5cff;
    min-width: 1.5rem;
  }

  .slice-canvas {
    display: block;
    border-radius: 10px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    background: #0f172a;
    image-rendering: pixelated;
  }

  .thresh-label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    font-size: 13px;
    font-weight: 600;
    color: #374151;
  }

  .thresh-label input[type="range"] {
    flex: 1;
    max-width: 280px;
    accent-color: #7a5cff;
  }

  /* ── CTA buttons ──────────────────────────────── */
  #cta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 22px;
    border-radius: 12px;
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    border: none;
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-primary {
    color: #fff;
    background: linear-gradient(83deg, #3245ff 0%, #bc52ee 100%);
    box-shadow:
      0 4px 20px rgba(114, 78, 255, 0.4),
      inset 0 0 0 1px rgba(255, 255, 255, 0.15),
      inset 0 -2px 0 rgba(0, 0, 0, 0.2);
  }

  .btn-primary:hover {
    box-shadow:
      0 8px 28px rgba(114, 78, 255, 0.55),
      inset 0 0 0 1px rgba(255, 255, 255, 0.2);
  }

  .btn-ghost {
    color: #374151;
    background: rgba(255, 255, 255, 0.6);
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.08),
      inset 0 0 0 1px rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(8px);
  }

  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.85);
  }

  .btn-primary:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  /* ── Result & error ───────────────────────────── */
  #error-panel {
    padding: 14px 18px;
    border-radius: 12px;
    background: rgba(254, 226, 226, 0.85);
    border: 1px solid rgba(248, 113, 113, 0.45);
    color: #991b1b;
    font-size: 15px;
    line-height: 1.5;
    margin-bottom: 20px;
  }

  .result-heading {
    font-size: 1.1rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 14px;
    letter-spacing: -0.02em;
  }

  .result-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    align-items: baseline;
    padding: 16px 20px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.85);
    box-shadow: 0 4px 28px rgba(0, 0, 0, 0.06);
    margin-bottom: 18px;
  }

  .result-label {
    font-size: 1.35rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 10px;
    letter-spacing: -0.02em;
  }

